public class PairSum{
    public static void main(String args[]){
        int arr[] = {0,1,2,3,4,5,6,8};
        int target = 14;
        for(int i=0;i<arr.length-1;i++){
            for(int j=i+1; j<arr.length;j++){
                if (arr[i] +arr[j]==target){
                System.out.println("Pair found: " + arr[i] + ", " + arr[j]);
            }

        }
    }

}
}
